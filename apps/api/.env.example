PORT=3000
# CockroachDB (única base de datos permitida). sslrootcert se ignora si el archivo no existe en el equipo.
DATABASE_URL=
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=
APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# IA: cualquier proveedor compatible con la API de OpenAI. Por defecto Google Gemini.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
AI_MODEL_SMART=gemini-3.5-flash
AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
AI_EMBED_MODEL=gemini-embedding-2
AI_EMBED_DIM=768

# Archivos de la biblioteca (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=

# Correo de recuperación (Resend)
RESEND_API_KEY=
MAIL_FROM=Ludoteka Campus <onboarding@resend.dev>
# Solo laboratorio: buzón real que recibe los códigos de las cuentas @eduquest.local.
LAB_OTP_INBOX=

# Acceso facial: distancia euclidiana máxima entre descriptores de 128 dimensiones
FACIAL_MAX_DISTANCE=0.5
FACIAL_POLICY_VERSION=2026-10-05
FACIAL_EMBEDDING_DIM=128
FACIAL_RETENTION_DAYS=0
FACIAL_LOCK_ATTEMPTS=5
FACIAL_LOCK_MINUTES=15
# Si se deja vacío, la llave AES se deriva de JWT_SECRET. Debe ser igual en todos los entornos que comparten la base.
FACIAL_ENC_KEY=

INTEGRITY_SUSPEND_AFTER=3
# Solo laboratorio. Las cuentas demo se crean la primera vez que la base está vacía.
SEED_PASSWORD=cambia-esta-clave
