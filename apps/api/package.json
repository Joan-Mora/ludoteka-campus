{
  "name": "@eduquest/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "migrate": "tsx src/scripts/cli.ts migrate",
    "seed": "tsx src/scripts/cli.ts seed",
    "library:seed": "tsx scripts/library-seed.ts",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@eduquest/contracts": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.1.6",
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "kysely": "^0.28.5",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.2",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "dependency-cruiser": "^16.10.4",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  }
}
